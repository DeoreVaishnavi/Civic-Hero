{
  "AllowedHosts": "civichero.example",
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "EnableDetailedErrors": false,
    "EnableSensitiveDataLogging": false,
    "CommandTimeout": 30,
    "EnableRetryOnFailure": true,
    "MaxRetryCount": 5,
    "MaxRetryDelaySeconds": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "https://civichero.example"
    ]
  },
  "Jwt": {
    "Issuer": "CivicHero",
    "Audience": "CivicHeroUsers",
    "ExpiryMinutes": 20,
    "RefreshTokenExpiryDays": 7,
    "RefreshCookieName": "civichero_refresh"
  },
  "Security": {
    "EnableRateLimiting": true,
    "EnableSecurityHeaders": true,
    "DefaultRequestBodyLimitMb": 2,
    "UploadRequestBodyLimitMb": 30,
    "General": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    },
    "Authentication": {
      "PermitLimit": 10,
      "WindowSeconds": 300
    },
    "Uploads": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    },
    "Administration": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    },
    "TwoFactorIssuer": "CivicHero",
    "DataProtectionKeysPath": "/app/data-protection-keys"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Redis": {
    "Enabled": false,
    "Configuration": "localhost:6379,abortConnect=false",
    "InstanceName": "civichero:",
    "DefaultTtlMinutes": 15
  },
  "RabbitMq": {
    "Enabled": false,
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "guest",
    "Password": "guest",
    "ExchangeName": "civichero.events",
    "QueueName": "civichero.backend",
    "PrefetchCount": 20,
    "MaximumRetries": 3,
    "RetryDelayMilliseconds": 15000
  },
  "Automation": {
    "Enabled": true,
    "PollIntervalSeconds": 60,
    "BatchSize": 100,
    "EscalationGraceHours": 12,
    "MediumVerificationHours": 72,
    "HighVerificationHours": 48,
    "CriticalVerificationHours": 24
  }
}
