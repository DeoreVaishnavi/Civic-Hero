{
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_RDS_ENDPOINT;Port=3306;Database=civicherodb;Uid=admin;Pwd=YOUR_PASSWORD;SslMode=Required;"
  },
  "AWS": {
    "Region": "ap-south-1",
    "AccessKey": "YOUR_AWS_ACCESS_KEY",
    "SecretKey": "YOUR_AWS_SECRET_KEY",
    "BucketName": "civichero-storage"
  },
  "Database": {
    "ServerVersion": "8.0.40",
    "CommandTimeout": 30,
    "EnableRetryOnFailure": true,
    "MaxRetryCount": 5,
    "MaxRetryDelaySeconds": 30,
    "EnableDetailedErrors": false,
    "EnableSensitiveDataLogging": false,
    "ApplyMigrationsOnStartup": false
  },
  "Jwt": {
    "Issuer": "CivicHero",
    "Audience": "CivicHeroUsers",
    "SecretKey": "CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY",
    "ExpiryMinutes": 60
  },
  "Mapbox": {
    "AccessToken": "YOUR_MAPBOX_ACCESS_TOKEN"
  },
  "AI": {
    "Provider": "Gemini",
    "ApiKey": "YOUR_AI_API_KEY",
    "Model": "gemini-2.5-pro"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://your-frontend-domain.com"
    ]
  },
  "Storage": {
    "Provider": "S3"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
