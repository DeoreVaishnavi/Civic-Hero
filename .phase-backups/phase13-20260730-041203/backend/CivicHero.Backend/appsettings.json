{
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_RDS_ENDPOINT;Port=3306;Database=civicherodb;Uid=admin;Pwd=YOUR_PASSWORD;SslMode=Required;"
  },
  "AWS": {
    "Region": "ap-south-1",
    "AccessKey": "YOUR_AWS_ACCESS_KEY",
    "SecretKey": "YOUR_AWS_SECRET_KEY",
    "BucketName": "civichero-storage"
  },
  "Database": {
    "CommandTimeout": 30,
    "EnableRetryOnFailure": true,
    "MaxRetryCount": 5,
    "MaxRetryDelaySeconds": 30,
    "EnableDetailedErrors": true,
    "EnableSensitiveDataLogging": false,
    "ApplyMigrationsOnStartup": false
  },
  "Jwt": {
    "Issuer": "CivicHero",
    "Audience": "CivicHeroUsers",
    "SecretKey": "CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARACTERS",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7,
    "RefreshCookieName": "civichero_refresh"
  },
  "BootstrapSuperAdmin": {
    "Enabled": false,
    "Email": "",
    "Password": "",
    "FullName": "CivicHero Super Admin"
  },
  "Mapbox": {
    "AccessToken": "YOUR_MAPBOX_ACCESS_TOKEN"
  },
  "AI": {
    "Provider": "RuleBased",
    "ApiKey": "YOUR_AI_API_KEY",
    "Model": "gemini-3.6-flash",
    "EnableBackgroundTriage": true,
    "WorkerIntervalSeconds": 60,
    "BatchSize": 20,
    "DuplicateRadiusMeters": 500,
    "PossibleDuplicateThreshold": 0.72,
    "ConfirmedDuplicateThreshold": 0.9,
    "FraudReviewThreshold": 0.65,
    "RecentSubmissionWindowHours": 24,
    "ExcessiveSubmissionCount": 8
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://your-frontend-domain.com"
    ]
  },
  "Storage": {
    "Provider": "S3"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Rewards": {
    "ClosedComplaintPoints": 10,
    "AutoClosedComplaintPoints": 10,
    "VerificationBonusPoints": 20,
    "UpvoteBonusPerVote": 2,
    "AwardWorkerIntervalSeconds": 120
  }
}
