{
  "AllowedHosts": "civichero.example",
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "EnableDetailedErrors": false,
    "EnableSensitiveDataLogging": false,
    "CommandTimeout": 30,
    "EnableRetryOnFailure": true,
    "MaxRetryCount": 5,
    "MaxRetryDelaySeconds": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "https://civichero.example"
    ]
  },
  "Jwt": {
    "Issuer": "CivicHero",
    "Audience": "CivicHeroUsers",
    "ExpiryMinutes": 20,
    "RefreshTokenExpiryDays": 7,
    "RefreshCookieName": "civichero_refresh"
  },
  "Security": {
    "EnableRateLimiting": true,
    "EnableSecurityHeaders": true,
    "DefaultRequestBodyLimitMb": 2,
    "UploadRequestBodyLimitMb": 30,
    "General": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    },
    "Authentication": {
      "PermitLimit": 10,
      "WindowSeconds": 300
    },
    "Uploads": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    },
    "Administration": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    },
    "TwoFactorIssuer": "CivicHero",
    "DataProtectionKeysPath": "/app/data-protection-keys",
    "AnonymousReporting": {
      "PermitLimit": 3,
      "WindowSeconds": 3600
    },
    "PhoneOtp": {
      "PermitLimit": 5,
      "WindowSeconds": 3600
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Redis": {
    "Enabled": false,
    "Configuration": "localhost:6379,abortConnect=false",
    "InstanceName": "civichero:",
    "DefaultTtlMinutes": 15
  },
  "RabbitMq": {
    "Enabled": false,
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "guest",
    "Password": "guest",
    "ExchangeName": "civichero.events",
    "QueueName": "civichero.backend",
    "PrefetchCount": 20,
    "MaximumRetries": 3,
    "RetryDelayMilliseconds": 15000
  },
  "Automation": {
    "Enabled": true,
    "PollIntervalSeconds": 60,
    "BatchSize": 100,
    "EscalationGraceHours": 12,
    "MediumVerificationHours": 72,
    "HighVerificationHours": 48,
    "CriticalVerificationHours": 24
  },
  "AnonymousReporting": {
    "Enabled": true,
    "TrackingDays": 30,
    "SystemReporterEmail": "anonymous-reporter@civichero.invalid",
    "MaximumSubmissionsPerHour": 3
  },
  "Captcha": {
    "Enabled": true,
    "Provider": "GoogleRecaptcha",
    "SecretKey": "",
    "ExpectedHostname": "",
    "MinimumScore": 0.5,
    "AllowDevelopmentBypass": false
  },
  "Sms": {
    "Provider": "Twilio",
    "AccountSid": "",
    "AuthToken": "",
    "FromNumber": "",
    "MessagingServiceSid": "",
    "AppName": "CivicHero",
    "OtpExpiryMinutes": 5,
    "ResendCooldownSeconds": 60,
    "MaximumRequestsPerHour": 5
  },
  "VisualVerification": {
    "Enabled": true,
    "Provider": "RuleBased",
    "ApiKey": "",
    "Model": "gemini-2.5-flash",
    "WorkerIntervalSeconds": 60,
    "BatchSize": 10,
    "MaximumImagesPerGroup": 1,
    "HumanReviewThreshold": 0.7
  }
}
