# Database and cloud (placeholders only)
RDS_CONNECTION_STRING=Server=YOUR_RDS_ENDPOINT;Port=3306;Database=civicherodb;Uid=YOUR_DB_USER;Pwd=YOUR_DB_PASSWORD;SslMode=Required;
AWS_REGION=ap-south-1
AWS_ACCESS_KEY=YOUR_AWS_ACCESS_KEY
AWS_SECRET_KEY=YOUR_AWS_SECRET_KEY
AWS_S3_BUCKET_NAME=civichero-images-mitesh
JWT_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_64_CHARACTERS

# Internal service authentication
INTERNAL_SERVICE_KEY=GENERATE_A_SECURE_RANDOM_INTERNAL_SERVICE_KEY

# Chatbot providers
GROQ_API_KEY=gsk_your_groq_api_key
NVIDIA_API_KEY=nvapi-your_nvidia_api_key
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
NVIDIA_CHAT_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_EMBED_MODEL=nvidia/nv-embedqa-e5-v5

# Vision runtime: use cuda only with a GPU-enabled container runtime
VISION_DEVICE=cpu
