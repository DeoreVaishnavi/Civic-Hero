{
  "ConnectionStrings": {
    "DefaultConnection": "Server=127.0.0.1;Port=3306;Database=civichero_testing;Uid=test;Pwd=test;SslMode=None;ConnectionTimeout=1;"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "EnableRetryOnFailure": false
  },
  "AWS": {
    "Region": "ap-south-1",
    "BucketName": "civichero-testing"
  },
  "Jwt": {
    "Issuer": "CivicHero.Tests",
    "Audience": "CivicHero.TestUsers",
    "SecretKey": "CivicHero_Phase14_Test_Key_Only_64_Characters_Minimum_1234567890",
    "ExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 1
  },
  "BootstrapSuperAdmin": {
    "Enabled": false
  },
  "Testing": {
    "SkipDatabaseInitialization": true,
    "DisableBackgroundServices": true
  },
  "Security": {
    "EnableRateLimiting": false,
    "EnableSecurityHeaders": true,
    "DefaultRequestBodyLimitMb": 2,
    "UploadRequestBodyLimitMb": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "http://127.0.0.1:4173",
      "http://localhost:5173"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Storage": {
    "Provider": "Local",
    "LocalRootPath": "App_Data/testing-uploads",
    "PrimaryAttemptTimeoutSeconds": 1
  }
}
