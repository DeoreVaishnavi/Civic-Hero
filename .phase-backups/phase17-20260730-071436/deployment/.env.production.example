COMPOSE_PROJECT_NAME=civichero-production
PUBLIC_ORIGIN=https://civichero.example
APP_HOST=civichero.example
ALLOWED_HOSTS=civichero.example
AWS_REGION=ap-south-1
AWS_BUCKET=civichero-storage
AI_PROVIDER=RuleBased
RELEASE_VERSION=1.0.0
COMMIT_SHA=replace-with-git-sha
SECRETS_DIR=./.secrets
BACKEND_IMAGE=ghcr.io/replace-owner/civichero-backend:1.0.0
FRONTEND_IMAGE=ghcr.io/replace-owner/civichero-frontend:1.0.0
