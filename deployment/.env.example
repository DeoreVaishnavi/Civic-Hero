COMPOSE_PROJECT_NAME=civichero-local
PUBLIC_HTTP_PORT=8088
PUBLIC_ORIGIN=http://localhost:8088
APP_HOST=localhost
ALLOWED_HOSTS=localhost
AWS_REGION=ap-south-1
AWS_BUCKET=civichero-storage
AI_PROVIDER=RuleBased
RELEASE_VERSION=phase15-local
COMMIT_SHA=local
SECRETS_DIR=./.secrets
BACKEND_IMAGE=civichero-backend:local
FRONTEND_IMAGE=civichero-frontend:local

REDIS_ENABLED=true
REDIS_CONFIGURATION=redis:6379,abortConnect=false
RABBITMQ_ENABLED=true
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_USER=civichero
RABBITMQ_PASSWORD=CHANGE-ME
RABBITMQ_MANAGEMENT_PORT=15672
