{
  "info": {
    "name": "CivicHero Phase 18 Release Smoke",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8088"
    }
  ],
  "item": [
    {
      "name": "Live health",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/health/live",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health",
            "live"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON response', () => pm.response.to.be.json);"
            ]
          }
        }
      ]
    },
    {
      "name": "Ready health",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/health/ready",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health",
            "ready"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json(); pm.test('All reported checks are healthy', () => pm.expect(body.status).to.eql('Healthy'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Anonymous profile is rejected",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/users/profile",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "users",
            "profile"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Unknown API does not expose stack trace",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/does-not-exist",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "does-not-exist"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 404', () => pm.response.to.have.status(404));",
              "pm.test('No stack trace', () => pm.expect(pm.response.text().toLowerCase()).not.to.include('stacktrace'));"
            ]
          }
        }
      ]
    }
  ]
}