{
  "AllowedHosts": "staging.civichero.example",
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "EnableDetailedErrors": false,
    "EnableSensitiveDataLogging": false
  },
  "Cors": {
    "AllowedOrigins": [
      "https://staging.civichero.example"
    ]
  },
  "Jwt": {
    "Issuer": "CivicHero",
    "Audience": "CivicHeroUsers",
    "ExpiryMinutes": 30,
    "RefreshTokenExpiryDays": 7,
    "RefreshCookieName": "civichero_refresh"
  },
  "Security": {
    "EnableRateLimiting": true,
    "EnableSecurityHeaders": true,
    "DefaultRequestBodyLimitMb": 2,
    "UploadRequestBodyLimitMb": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
